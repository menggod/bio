<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 第1层：立体空间环境软阴影 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#33000000" />
        </shape>
    </item>

    <!-- 第2层：极光水晶倒角高光线 (模拟物理玻璃斜切折射边，左上冰川透亮，右下极光微蓝) -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <gradient
                android:angle="315"
                android:startColor="#B3E2E8F0"
                android:centerColor="#3338BDF8"
                android:endColor="#660284C7"
                android:type="linear" />
        </shape>
    </item>

    <!-- 第3层：深海钛青极光玻璃主体 (72% 通透度，能透出壁纸光影，深邃通透不廉价) -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="315"
                android:startColor="#C4132034"
                android:centerColor="#B80B1322"
                android:endColor="#AB050A14"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
