<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_2x2_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_modern"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="10dp"
    android:paddingRight="12dp"
    android:paddingBottom="10dp">

    <!-- 顶部：姓名与简短日期 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_2x2_text_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="我 (自己)"
            android:textColor="#F8FAFC"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_2x2_text_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10/26 一"
            android:textColor="#94A3B8"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- 中间：综合运势微晶胶囊评价 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_card_item"
        android:gravity="center"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_2x2_text_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="✦ 黄金顺遂"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 底部：三大节律紧凑微型进度槽 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- 1. 体力 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:text="体"
                android:textColor="#EF4444"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_2x2_progress_physic"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="80"
                android:progressDrawable="@drawable/widget_progress_physic" />

            <TextView
                android:id="@+id/widget_2x2_text_physic_val"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:text="+80%"
                android:textColor="#EF4444"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. 情绪 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:text="绪"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_2x2_progress_emotional"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="65"
                android:progressDrawable="@drawable/widget_progress_emotional" />

            <TextView
                android:id="@+id/widget_2x2_text_emotional_val"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:text="+65%"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. 智力 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="16dp"
                android:layout_height="wrap_content"
                android:text="智"
                android:textColor="#4ADE80"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_2x2_progress_intellect"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/widget_progress_intellect" />

            <TextView
                android:id="@+id/widget_2x2_text_intellect_val"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:text="+50%"
                android:textColor="#4ADE80"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
